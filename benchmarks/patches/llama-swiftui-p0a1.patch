+                loopStatus = String(
+                    format: "LOOP %d gens | %d tokens | %.0fs wall | first %.2f t/s | last %.2f t/s",
+                    generations, cumulativeTokens, wall, firstTps, tps)
+            }
+        }
+    }
+
+    func stopLoop() {
+        looping = false
+    }
