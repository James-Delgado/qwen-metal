+// MARK: - qwen-metal P6-2: per-generation record + export rendering
+
+struct QwenMetalP6Record: Codable {
+    let index: Int
+    let promptTokenCount: Int
+    let generatedTokens: Int
+    /// completion_init start (before tokenize) -> first sampled token available (wall, s).
+    let prefillSpanSeconds: Double?
+    /// Host tokenization, INSIDE the span (the spec D1 llama.cpp bracket), listed for transparency.
+    let tokenizeSeconds: Double
+    /// llama_decode(prompt batch) enqueue wall — ASYNC on Metal, not prefill; listed for transparency.
+    let promptEnqueueSeconds: Double
+    let wallSeconds: Double
+    let elapsedAtEndSeconds: Double
+    let overallTokensPerSecond: Double?
+    let canonicalWindowTokensPerSecond: Double?
+    /// qwen-metal GenerationStopReason vocabulary.
+    let stopReason: String
+    let truncated: Bool
+
+    static let windowFirstToken = 128
+    static let windowLastToken = 512
+    /// qwen-metal BenchDefaults.burstMaxNewTokens.
+    static let burstMaxNewTokens: Int32 = 640
+
+    var prefillTokensPerSecond: Double? {
+        guard let s = prefillSpanSeconds, s > 0 else { return nil }
+        return Double(promptTokenCount) / s
+    }
+
+    /// 384 / (t512 - t128); nil below 512 generated tokens.
+    static func window(_ t: [Double]) -> Double? {
+        guard t.count >= windowLastToken else { return nil }
+        let elapsed = t[windowLastToken - 1] - t[windowFirstToken - 1]
+        guard elapsed > 0 else { return nil }
+        return Double(windowLastToken - windowFirstToken) / elapsed
+    }
+
+    /// (n - 1) / (t_n - t_1): the first token's availability is the span's start marker.
+    static func overall(_ t: [Double]) -> Double? {
+        guard t.count >= 2, let first = t.first, let last = t.last, last > first else { return nil }
+        return Double(t.count - 1) / (last - first)
+    }
+
+    static func empty(index: Int) -> QwenMetalP6Record {
+        QwenMetalP6Record(index: index, promptTokenCount: 0, generatedTokens: 0, prefillSpanSeconds: nil,
+                          tokenizeSeconds: 0, promptEnqueueSeconds: 0, wallSeconds: 0, elapsedAtEndSeconds: 0,
+                          overallTokensPerSecond: nil, canonicalWindowTokensPerSecond: nil,
+                          stopReason: "noContext", truncated: false)
+    }
+
+    var textLine: String {
+        let overall = overallTokensPerSecond.map { String(format: "%.2f tok/s", $0) } ?? "n/a"
+        let windowed = canonicalWindowTokensPerSecond.map { String(format: ", window %.2f tok/s", $0) } ?? ""
+        return String(format: "  gen %d: overall %@%@ — %d tokens in %.1f s (stop: %@) [elapsed %.1f s]%@",
+                      index, overall, windowed, generatedTokens, wallSeconds, stopReason, elapsedAtEndSeconds,
+                      truncated ? " [truncated by operator stop]" : "")
+    }
+}
+
+struct QwenMetalP6ExportContext {
+    let runMode: String
+    let promptName: String
+    let promptTokenCount: Int
+    let nCtx: Int
+    let records: [QwenMetalP6Record]
+    let endedByOperatorStop: Bool
+    let cycleWallSeconds: Double
+    let batteryHealth: String
+    let socStart: String
+    let socEnd: String
+    let socProgrammaticStart: Double?
+    let socProgrammaticEnd: Double?
+    let coldOrWarm: String
+    let round: String
+    let memoryLine: String
+
+    /// Counts on record (DECISIONS.md 2026-08-22): llama.cpp's tokenizer vs HF.
+    static let recordedCounts: [String: (llama: Int, hf: Int)] = [
+        "decode-essay": (92, 84), "prefill-summarize": (852, 852),
+    ]
+    static let harnessLine = "llama.cpp b9999 47c78692 llama.swiftui + qwen-metal-p0a1 (97e552a, bceddff) + P6-2 patch"
+    static let checkpointLine = "locally converted Q4_K_M GGUF (qwen3-1.7b-70d244cc-Q4_K_M.gguf, sha256 in qwen-metal DECISIONS.md), from Qwen/Qwen3-1.7B @ 70d244cc"
+    static let validationLine = "Metal API validation: OFF (llama.swiftui scheme carries enableGPUValidationMode=1 = Disabled upstream; detached home-screen launches carry no validation layer at all)"
+
+    static func percentOrPlaceholder(_ note: String) -> String {
+        var t = note.trimmingCharacters(in: .whitespacesAndNewlines)
+        if t.hasSuffix("%") { t.removeLast() }
+        return t.isEmpty ? "(record manually)" : t + "%"
+    }
+    static func programmatic(_ v: Double?) -> String { v.map { String(format: "%.1f%%", $0) } ?? "n/a (unavailable)" }
+
+    func text() -> String {
+        let roundTrimmed = round.trimmingCharacters(in: .whitespacesAndNewlines)
+        var lines: [String] = []
+        lines.append(roundTrimmed.isEmpty
+                     ? "qwen-metal Phase 6 row export (PROVISIONAL) — engine: llama-swiftui"
+                     : "qwen-metal Phase 6 row export (round: \(roundTrimmed)) — engine: llama-swiftui")
+        lines.append("round: " + (roundTrimmed.isEmpty ? "(none — PROVISIONAL)" : roundTrimmed))
+        lines.append("harness: " + Self.harnessLine)
+        lines.append("checkpoint: " + Self.checkpointLine)
+        lines.append("mode: " + runMode)
+        let rec = Self.recordedCounts[promptName]
+        let countNote: String
+        if let rec {
+            countNote = promptTokenCount == rec.llama
+                ? "matches the llama.cpp count on record (\(rec.llama)); HF/qwen-metal count \(rec.hf) — tokenizer difference, reported as pinned"
+                : "DIFFERS from the llama.cpp count on record (\(rec.llama)) — investigate before using the row; HF/qwen-metal count \(rec.hf)"
+        } else {
+            countNote = "no count on record for this prompt"
+        }
+        lines.append("prompt: \(promptName) (\(promptTokenCount) tokens, llama.cpp tokenizer, parse_special=true; feeding: RENDERED bundled string; \(countNote))")
+        lines.append("sampling: greedy (llama_sampler_init_greedy); burst cap \(QwenMetalP6Record.burstMaxNewTokens) new tokens; loop cap = n_ctx − prompt (reset on EOS or context fill); n_ctx \(nCtx)")
+        lines.append(Self.validationLine)
+        lines.append("cold/warm: " + (coldOrWarm.isEmpty ? "(record manually)" : coldOrWarm))
+        lines.append("battery health: \(Self.percentOrPlaceholder(batteryHealth)) (maximum capacity %, Settings → Battery → Battery Health, operator-typed — NOT state of charge)")
+        if runMode == "energy-loop" {
+            lines.append("state of charge (Settings → Battery, operator-read at the band marks — value of record): start \(Self.percentOrPlaceholder(socStart)), end \(Self.percentOrPlaceholder(socEnd))")
+            lines.append("state of charge (programmatic UIDevice.batteryLevel — cross-check only, never the value of record): start \(Self.programmatic(socProgrammaticStart)), end \(Self.programmatic(socProgrammaticEnd))")
+        }
+        lines.append(memoryLine)
+        lines.append("definitions: decode tok/s = 384 / (t512 − t128), t_k = host monotonic time right after llama_sampler_sample returns token k (llama_get_logits_ith synchronizes the backend first); prefill span = completion_init start → first sampled token available = tokenize + one llama_decode over the prompt batch + first sample (spec D1); the prompt llama_decode enqueue is async and listed separately")
+        if runMode == "burst" {
+            if let r = records.first { lines.append(contentsOf: Self.generationLines(r)) }
+        } else {
+            let total = records.reduce(0) { $0 + $1.generatedTokens }
+            let sumWall = records.reduce(0.0) { $0 + $1.wallSeconds }
+            let truncated = records.last?.truncated ?? false
+            lines.append(String(format: "energy cycle: %d generations — ended by %@%@", records.count,
+                                endedByOperatorStop ? "operator stop" : "loop halt",
+                                truncated ? " (final generation truncated at a token boundary)" : ""))
+            lines.append(String(format: "cumulative: %d generated tokens; Σ generation wall %.1f s; cycle wall %.1f s", total, sumWall, cycleWallSeconds))
+            lines.append("energy J/token is derived by tools/phase6_analyze.py from these raw fields (never in-harness)")
+            lines.append(contentsOf: records.map(\.textLine))
+            if let last = records.last {
+                lines.append("last generation:")
+                lines.append(contentsOf: Self.generationLines(last))
+            }
+        }
+        return lines.joined(separator: "\n") + "\n"
+    }
+
+    static func generationLines(_ r: QwenMetalP6Record) -> [String] {
+        var lines: [String] = []
+        lines.append(String(format: "generated: %d tokens in %.1f s (stop: %@)", r.generatedTokens, r.wallSeconds, r.stopReason))
+        if let span = r.prefillSpanSeconds, let tps = r.prefillTokensPerSecond {
+            lines.append(String(format: "prefill span: %d tokens in %.3f s = %.2f tok/s (of record — wall, completion_init start to first sampled token available; tokenize %.1f ms inside the span; prompt llama_decode enqueue %.1f ms, async)",
+                                r.promptTokenCount, span, tps, r.tokenizeSeconds * 1000, r.promptEnqueueSeconds * 1000))
+        } else {
+            lines.append("prefill span: n/a (no token generated)")
+        }
+        let overall = r.overallTokensPerSecond.map { String(format: "%.2f tok/s", $0) } ?? "n/a"
+        let windowed = r.canonicalWindowTokensPerSecond.map { String(format: "%.2f tok/s", $0) }
+            ?? String(format: "n/a (needs >= %d generated tokens, got %d)", QwenMetalP6Record.windowLastToken, r.generatedTokens)
+        lines.append("decode rate: overall \(overall), canonical window (tokens \(QwenMetalP6Record.windowFirstToken)-\(QwenMetalP6Record.windowLastToken)) \(windowed)")
+        return lines
+    }
+
+    struct TimelineJSON: Codable {
+        struct Battery: Codable {
+            let healthNote: String?
+            let operatorSoCStart: String?
+            let operatorSoCEnd: String?
+            let programmaticSoCStartPercent: Double?
+            let programmaticSoCEndPercent: Double?
+        }
+        struct CycleTotals: Codable {
+            let generations: Int
+            let totalGeneratedTokens: Int
+            let sumGenerationWallSeconds: Double
+            let cycleWallSeconds: Double
+            let endedBy: String
+            let lastGenerationTruncated: Bool
+        }
+        let schema: String
+        let engine: String
+        let phase: String
+        let round: String?
+        let mode: String
+        let promptName: String
+        let promptTokenCount: Int
+        let feedingMode: String
+        let feedingParity: String
+        let nCtx: Int
+        let elapsedBasis: String
+        let battery: Battery
+        let cycleTotals: CycleTotals
+        let entries: [QwenMetalP6Record]
+    }
+
+    func json() -> String {
+        func nonEmpty(_ s: String) -> String? {
+            let t = s.trimmingCharacters(in: .whitespacesAndNewlines)
+            return t.isEmpty ? nil : t
+        }
+        let rec = Self.recordedCounts[promptName]
+        let parity = rec.map { promptTokenCount == $0.llama ? "matches-llama-count-on-record" : "DIFFERS-from-llama-count-on-record" } ?? "no-count-on-record"
+        let isLoop = runMode == "energy-loop"
+        let doc = TimelineJSON(
+            schema: "qwen-metal-timeline/1-external", engine: "llama-swiftui", phase: "6",
+            round: nonEmpty(round), mode: runMode, promptName: promptName, promptTokenCount: promptTokenCount,
+            feedingMode: "rendered", feedingParity: parity, nCtx: nCtx, elapsedBasis: "loopClock",
+            battery: .init(healthNote: nonEmpty(batteryHealth),
+                           operatorSoCStart: isLoop ? nonEmpty(socStart) : nil,
+                           operatorSoCEnd: isLoop ? nonEmpty(socEnd) : nil,
+                           programmaticSoCStartPercent: socProgrammaticStart,
+                           programmaticSoCEndPercent: socProgrammaticEnd),
+            cycleTotals: .init(generations: records.count,
+                               totalGeneratedTokens: records.reduce(0) { $0 + $1.generatedTokens },
+                               sumGenerationWallSeconds: records.reduce(0.0) { $0 + $1.wallSeconds },
+                               cycleWallSeconds: cycleWallSeconds,
+                               endedBy: isLoop ? (endedByOperatorStop ? "operatorStop" : "loopHalt") : "burst",
+                               lastGenerationTruncated: records.last?.truncated ?? false),
+            entries: records)
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.prettyPrinted, .sortedKeys]
+        guard let data = try? encoder.encode(doc), let text = String(data: data, encoding: .utf8) else { return "{}" }
+        return text + "\n"
+    }
+}
