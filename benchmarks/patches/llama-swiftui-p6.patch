+#endif
 
 struct Model: Identifiable {
     var id = UUID()
@@ -225,6 +228,212 @@ class LlamaState: ObservableObject {
         looping = false
     }
 
+    // MARK: - qwen-metal P6-2 (phase-6.md D1/D2/D4): Phase 6 parity bench
+    //
+    // Same definitions as the qwen-metal engine and the MLX LLMEval patch:
+    // decode tok/s of record = 384 / (t512 - t128) from per-token
+    // availability timestamps taken in LlamaContext (right after the
+    // sampler returns — it synchronized on the logits); prefill span =
+    // completion_init start -> first sample returned (tokenize + one
+    // prompt llama_decode + first sample); per-generation loop timeline;
+    // health and SoC as separate fields; operator Stop that still reports.
+    // Feeding: the bundled pinned RENDERED prompt (parse_special=true, the
+    // P0A-1 pin). llama.cpp's own prompt token counts are recorded per row
+    // (92 / 852 on record vs HF 84 / 852) — a tokenizer difference,
+    // reported as pinned, not a parity failure.
+
+    @Published var p6Status = ""
+    @Published var p6ExportText = ""
+    @Published var p6TimelineJSON = ""
+    @Published var p6Output = ""
+    @Published var p6Running = false
+    @Published var p6Looping = false
+    @Published var p6Prompt = "decode-essay"
+    @Published var p6BatteryHealth = "" { didSet { p6RenderExports() } }
+    @Published var p6SoCStart = "" { didSet { p6RenderExports() } }
+    @Published var p6SoCEnd = "" { didSet { p6RenderExports() } }
+    @Published var p6ColdOrWarm = "" { didSet { p6RenderExports() } }
+    @Published var p6Round = "" { didSet { p6RenderExports() } }
+
+    private var p6Records: [QwenMetalP6Record] = []
+    private var p6RunMode = "burst"
+    private var p6EndedByOperatorStop = false
+    private var p6CycleWallSeconds = 0.0
+    private var p6SoCProgrammatic: (start: Double?, end: Double?) = (nil, nil)
+    private var p6MemoryLine = ""
+    private var p6PromptTokenCount = 0
+    private var p6NCtx = 0
+    private var p6StopRequested = false
+
+    /// qwen-metal burst cap (BenchDefaults.burstMaxNewTokens): 640 NEW tokens.
+    nonisolated static let p6BurstMaxNewTokens: Int32 = QwenMetalP6Record.burstMaxNewTokens
+
+    func p6BundledPrompt(_ name: String) -> String? {
+        guard let url = Bundle.main.url(forResource: name + ".rendered", withExtension: "txt", subdirectory: "models"),
+              let text = try? String(contentsOf: url, encoding: .utf8) else { return nil }
+        return text
+    }
+
+    /// Burst row: one generation, 640 new tokens max (= qwen-metal), no per-token UI.
+    func p6Burst() {
+        guard !p6Running, !p6Looping, llamaContext != nil else { return }
+        guard let text = p6BundledPrompt(p6Prompt) else { p6Status = "ERROR: bundled prompt \(p6Prompt) not found"; return }
+        p6Running = true
+        p6StopRequested = false
+        Task {
+            defer { p6Running = false }
+            let record = await p6GenerateOnce(text: text, index: 0, newTokenCap: Self.p6BurstMaxNewTokens,
+                                              isContextFill: false, loopClockStartNs: nil)
+            p6RunMode = "burst"
+            p6Records = [record]
+            p6EndedByOperatorStop = false
+            p6CycleWallSeconds = record.wallSeconds
+            p6SoCProgrammatic = (nil, nil)
+            p6RenderExports()
+            p6Status = String(format: "burst done — %d tokens, window %@, prefill %@",
+                              record.generatedTokens,
+                              record.canonicalWindowTokensPerSecond.map { String(format: "%.2f tok/s", $0) } ?? "n/a (<512 tokens)",
+                              record.prefillTokensPerSecond.map { String(format: "%.2f tok/s", $0) } ?? "n/a")
+        }
+    }
+
+    /// Energy / sustained loop: regenerate the SAME prompt, reset on EOS or
+    /// context fill (cap = n_ctx - prompt), until the operator presses
+    /// Stop; the in-flight generation ends at its next token boundary and
+    /// the loop ALWAYS reports.
+    func p6StartLoop() {
+        guard !p6Running, !p6Looping, llamaContext != nil else { return }
+        guard let text = p6BundledPrompt(p6Prompt) else { p6Status = "ERROR: bundled prompt \(p6Prompt) not found"; return }
+        p6Running = true
+        p6Looping = true
+        p6StopRequested = false
+        Task {
+            defer { p6Running = false; p6Looping = false }
+            var records: [QwenMetalP6Record] = []
+            let socStart = Self.p6ProgrammaticStateOfChargePercent()
+            let loopStartNs = DispatchTime.now().uptimeNanoseconds
+            var index = 0
+            var endedByStop = false
+            while true {
+                if p6StopRequested { endedByStop = true; break }
+                // Cap = context fill: the actor derives n_gen_max = n_ctx -
+                // n_prompt at completion_init (the count is known there).
+                let record = await p6GenerateOnce(text: text, index: index,
+                                                  newTokenCap: Self.p6BurstMaxNewTokens,
+                                                  isContextFill: true, loopClockStartNs: loopStartNs)
+                records.append(record)
+                index += 1
+                p6Status = String(format: "LOOP gen %d: %d tokens, window %@ — %d gens, %d tokens, %.0f s",
+                                  record.index, record.generatedTokens,
+                                  record.canonicalWindowTokensPerSecond.map { String(format: "%.2f", $0) } ?? "n/a",
+                                  records.count, records.reduce(0) { $0 + $1.generatedTokens },
+                                  Double(DispatchTime.now().uptimeNanoseconds - loopStartNs) / NS_PER_S)
+                if record.truncated { endedByStop = true; break }
+                if record.generatedTokens == 0 { p6Status = "loop halted: empty generation (refusing to spin)"; break }
+            }
+            let cycleWall = Double(DispatchTime.now().uptimeNanoseconds - loopStartNs) / NS_PER_S
+            let socEnd = Self.p6ProgrammaticStateOfChargePercent()
+            p6RunMode = "energy-loop"
+            p6Records = records
+            p6EndedByOperatorStop = endedByStop
+            p6CycleWallSeconds = cycleWall
+            p6SoCProgrammatic = (socStart, socEnd)
+            p6RenderExports()
+            p6Status = String(format: "loop stopped — %d generations, %d tokens, cycle wall %.0f s; type SoC at stop + battery health, then Copy export",
+                              records.count, records.reduce(0) { $0 + $1.generatedTokens }, cycleWall)
+        }
+    }
+
+    func p6RequestStop() {
+        p6StopRequested = true
+        Task { await llamaContext?.p6_request_stop() }
+    }
+
+    private func p6GenerateOnce(text: String, index: Int, newTokenCap: Int32, isContextFill: Bool,
+                                loopClockStartNs: UInt64?) async -> QwenMetalP6Record {
+        guard let llamaContext else {
+            return QwenMetalP6Record.empty(index: index)
+        }
+        await llamaContext.p6_set_generation_cap(newTokens: newTokenCap, isContextFill: isContextFill)
+        // The token loop runs detached (no main-actor hop per token — the
+        // P0A-1 measurement lesson); nothing touches the UI until the end.
+        let outcome: (text: String, tEndNs: UInt64) = await Task.detached(priority: .userInitiated) {
+            await llamaContext.completion_init(text: text)
+            var generated = ""
+            while await !llamaContext.is_done {
+                generated += await llamaContext.completion_loop()
+            }
+            return (generated, DispatchTime.now().uptimeNanoseconds)
+        }.value
+        let stamps = await llamaContext.p6_timeline_ns()
+        let tInit = await llamaContext.p6_init_start_ns()
+        let tTok = await llamaContext.p6_tokenize_done_ns()
+        let tEnq = await llamaContext.p6_prompt_enqueued_ns()
+        let stopReason = await llamaContext.p6_stop_reason()
+        let promptCount = Int(await llamaContext.n_prompt)
+        let generated = Int(await llamaContext.n_decode)
+        p6NCtx = Int(await llamaContext.p6_n_ctx())
+        await llamaContext.clear()
+        p6PromptTokenCount = promptCount
+        p6Output = outcome.text
+        p6MemoryLine = Self.p6MemoryLine()
+
+        let seconds = { (ns: UInt64) in Double(ns) / self.NS_PER_S }
+        let timeline = stamps.map(seconds)
+        return QwenMetalP6Record(
+            index: index,
+            promptTokenCount: promptCount,
+            generatedTokens: generated,
+            prefillSpanSeconds: stamps.first.map { seconds($0 - tInit) },
+            tokenizeSeconds: seconds(tTok - tInit),
+            promptEnqueueSeconds: seconds(tEnq - tTok),
+            wallSeconds: seconds(outcome.tEndNs - tInit),
+            elapsedAtEndSeconds: loopClockStartNs.map { seconds(outcome.tEndNs - $0) } ?? 0,
+            overallTokensPerSecond: QwenMetalP6Record.overall(timeline),
+            canonicalWindowTokensPerSecond: QwenMetalP6Record.window(timeline),
+            stopReason: stopReason.isEmpty ? "unknown" : stopReason,
+            truncated: stopReason == "stopRequested")
+    }
+
+    private func p6RenderExports() {
+        guard !p6Records.isEmpty else { return }
+        let ctx = QwenMetalP6ExportContext(
+            runMode: p6RunMode, promptName: p6Prompt, promptTokenCount: p6PromptTokenCount, nCtx: p6NCtx,
+            records: p6Records, endedByOperatorStop: p6EndedByOperatorStop, cycleWallSeconds: p6CycleWallSeconds,
+            batteryHealth: p6BatteryHealth, socStart: p6SoCStart, socEnd: p6SoCEnd,
+            socProgrammaticStart: p6SoCProgrammatic.start, socProgrammaticEnd: p6SoCProgrammatic.end,
+            coldOrWarm: p6ColdOrWarm, round: p6Round, memoryLine: p6MemoryLine)
+        p6ExportText = ctx.text()
+        p6TimelineJSON = ctx.json()
+    }
+
+    /// `UIDevice.batteryLevel` in percent; nil when unavailable (-1). Cross-check only.
+    static func p6ProgrammaticStateOfChargePercent() -> Double? {
+        #if canImport(UIKit) && !os(visionOS)
+        let device = UIDevice.current
+        device.isBatteryMonitoringEnabled = true
+        let level = device.batteryLevel
+        guard level >= 0 else { return nil }
+        return Double(level) * 100
+        #else
+        return nil
+        #endif
+    }
+
+    /// task_info phys_footprint — cross-check only; the Xcode gauge on an
+    /// attached footprint-only launch is the value of record (spec D3).
+    nonisolated static func p6MemoryLine() -> String {
+        var info = task_vm_info_data_t()
+        var count = mach_msg_type_number_t(MemoryLayout<task_vm_info_data_t>.size / MemoryLayout<natural_t>.size)
+        let kr = withUnsafeMutablePointer(to: &info) {
+            $0.withMemoryRebound(to: integer_t.self, capacity: Int(count)) {
+                task_info(mach_task_self_, task_flavor_t(TASK_VM_INFO), $0, &count)
+            }
+        }
+        let footprint = kr == KERN_SUCCESS ? String(format: "%.0f MB", Double(info.phys_footprint) / 1_048_576) : "n/a"
+        return "memory (cross-check only — Xcode gauge phys_footprint is the value of record; mmap'd GGUF pages are file-backed and excluded, the invariant-3 accounting asymmetry): task_info phys_footprint \(footprint)"
+    }
+
     func bench() async {
         guard let llamaContext else {
             return
@@ -263,3 +472,224 @@ class LlamaState: ObservableObject {
         messageLog = ""
     }
 }
