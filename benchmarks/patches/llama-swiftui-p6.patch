@@ -46,6 +46,54 @@ actor LlamaContext {
 
     var n_decode: Int32 = 0
 
+    // qwen-metal P6-2 (phase-6.md D1): parity instrumentation.
+    // - n_gen_max caps GENERATED tokens (qwen-metal burstMaxNewTokens = 640
+    //   new tokens; the loop sets it to n_ctx - n_prompt so a generation
+    //   resets on EOS or context fill, the pinned regenerate policy). n_len
+    //   is derived from it per completion (n_prompt + n_gen_max).
+    // - token_available_ns[k-1] = monotonic host time at which generated
+    //   token k's id is available: taken right after llama_sampler_sample
+    //   returns. That call reads logits via llama_get_logits_ith, which
+    //   synchronizes the backend first (src/llama-context.cpp, b9999
+    //   47c78692), so the timestamp is a real GPU-completion mark, not an
+    //   enqueue time. Decode tok/s of record = 384 / (t512 - t128).
+    // - prefill span = completion_init start (before tokenize) -> first
+    //   sample returned = tokenize + one llama_decode over the prompt batch
+    //   + first sample, exactly the spec D1 bracket. llama_decode itself
+    //   returns after an ASYNC enqueue on the Metal backend (the P0A-1
+    //   finding), so the enqueue sub-span is recorded but is not prefill.
+    var n_gen_max: Int32 = 640
+    /// Burst cap (new tokens); the loop derives n_gen_max = n_ctx - n_prompt at completion_init instead.
+    var burst_gen_cap: Int32 = 640
+    var t_init_start_ns: UInt64 = 0
+    var t_tokenize_done_ns: UInt64 = 0
+    var t_prompt_enqueued_ns: UInt64 = 0
+    var token_available_ns: [UInt64] = []
+    var stop_requested = false
+    /// qwen-metal GenerationStopReason vocabulary: eos | contextFull | maxNewTokens | stopRequested
+    var stop_reason = ""
+    var cap_is_context_fill = false
+
+    /// Burst: cap = `newTokens` generated tokens. Context-fill (loop): the
+    /// cap is derived per completion as n_ctx - n_prompt (the prompt count
+    /// is only known after tokenize), so a generation resets exactly at
+    /// the context fill — never beyond it.
+    func p6_set_generation_cap(newTokens: Int32, isContextFill: Bool) {
+        burst_gen_cap = newTokens
+        cap_is_context_fill = isContextFill
+    }
+
+    func p6_request_stop() {
+        stop_requested = true
+    }
+
+    func p6_timeline_ns() -> [UInt64] { token_available_ns }
+    func p6_init_start_ns() -> UInt64 { t_init_start_ns }
+    func p6_tokenize_done_ns() -> UInt64 { t_tokenize_done_ns }
+    func p6_prompt_enqueued_ns() -> UInt64 { t_prompt_enqueued_ns }
+    func p6_stop_reason() -> String { stop_reason }
+    func p6_n_ctx() -> Int32 { Int32(llama_n_ctx(context)) }
+
     init(model: OpaquePointer, context: OpaquePointer) {
         self.model = model
         self.context = context
@@ -86,7 +134,13 @@ actor LlamaContext {
         print("Using \(n_threads) threads")
 
         var ctx_params = llama_context_default_params()
-        ctx_params.n_ctx = 2048
+        // qwen-metal P6-2: 4096 = the pinned regenerate policy's context
+        // (PLAN "reset when the 4K context fills"; qwen-metal contextCap
+        // 4096, MLX loop cap 4096 - prompt). Phase 0 rows ran at the
+        // upstream 2048 with a 640-total cap; the Phase 6 loops reset at
+        // the same point on every engine. KV allocation grows accordingly
+        // (reported honestly in the phys_footprint row).
+        ctx_params.n_ctx = 4096
         ctx_params.n_threads       = Int32(n_threads)
         ctx_params.n_threads_batch = Int32(n_threads)
 
@@ -124,10 +178,22 @@ actor LlamaContext {
     }
 
     func completion_init(text: String) {
-        print("attempting to complete \"\(text)\"")
+        // qwen-metal P6-2: prefill span starts here (spec D1 bracket).
+        t_init_start_ns = DispatchTime.now().uptimeNanoseconds
+        token_available_ns = []
+        stop_reason = ""
+        // (stop_requested is NOT reset here — a Stop pressed between two
+        // loop generations must still end the next one at its first token
+        // boundary; clear() resets it after each completion.)
 
         tokens_list = tokenize(text: text, add_bos: true)
         n_prompt = Int32(tokens_list.count)
+        t_tokenize_done_ns = DispatchTime.now().uptimeNanoseconds
+        // qwen-metal P6-2: generated-token cap (burst) or context fill (loop);
+        // the total-length cap n_len is derived from it and never exceeds n_ctx.
+        let n_ctx_now = Int32(llama_n_ctx(context))
+        n_gen_max = cap_is_context_fill ? max(1, n_ctx_now - n_prompt) : min(burst_gen_cap, max(1, n_ctx_now - n_prompt))
+        n_len = n_prompt + n_gen_max
         temporary_invalid_cchars = []
         // qwen-metal P0A-1: reset per-completion state — upstream clear()
         // never resets these, so every generation after the first in an app
@@ -162,6 +228,8 @@ actor LlamaContext {
         if llama_decode(context, batch) != 0 {
             print("llama_decode() failed")
         }
+        // qwen-metal P6-2: async enqueue mark (NOT prefill — see above).
+        t_prompt_enqueued_ns = DispatchTime.now().uptimeNanoseconds
 
         n_cur = batch.n_tokens
     }
@@ -170,14 +238,20 @@ actor LlamaContext {
         var new_token_id: llama_token = 0
 
         new_token_id = llama_sampler_sample(sampling, context, batch.n_tokens - 1)
-
-        if llama_vocab_is_eog(vocab, new_token_id) || n_cur == n_len {
-            print("\n")
+        // qwen-metal P6-2: the sampler synchronized on the logits — token
+        // k (= n_decode + 1) is host-available NOW.
+        let t_available_ns = DispatchTime.now().uptimeNanoseconds
+
+        if llama_vocab_is_eog(vocab, new_token_id) {
+            // The EOG token is not a generated token (qwen-metal counts
+            // n_decode the same way): no timestamp, stop reason eos.
+            stop_reason = "eos"
             is_done = true
             let new_token_str = String(cString: temporary_invalid_cchars + [0])
             temporary_invalid_cchars.removeAll()
             return new_token_str
         }
+        token_available_ns.append(t_available_ns)
 
         let new_token_cchars = token_to_piece(token: new_token_id)
         temporary_invalid_cchars.append(contentsOf: new_token_cchars)
@@ -196,10 +270,32 @@ actor LlamaContext {
         // qwen-metal P0A-1: per-token print removed (timing distortion)
         // tokens_list.append(new_token_id)
 
+        n_decode += 1
+
+        // qwen-metal P6-2: stop at the token boundary AFTER token k is
+        // available, BEFORE its decode is enqueued: generated-token cap
+        // (burst maxNewTokens / loop contextFull) or the operator stop.
+        if n_decode >= n_gen_max {
+            stop_reason = cap_is_context_fill ? "contextFull" : "maxNewTokens"
+            is_done = true
+            return new_token_str
+        }
+        // Defensive: never enqueue a position at or past n_ctx (a failed
+        // llama_decode would otherwise spin without ever setting is_done).
+        if n_cur + 1 >= Int32(llama_n_ctx(context)) {
+            stop_reason = "contextFull"
+            is_done = true
+            return new_token_str
+        }
+        if stop_requested {
+            stop_reason = "stopRequested"
+            is_done = true
+            return new_token_str
+        }
+
         llama_batch_clear(&batch)
         llama_batch_add(&batch, new_token_id, n_cur, [0], true)
 
-        n_decode += 1
         n_cur    += 1
 
         if llama_decode(context, batch) != 0 {
@@ -311,6 +407,8 @@ actor LlamaContext {
         tokens_list.removeAll()
         temporary_invalid_cchars.removeAll()
         llama_memory_clear(llama_get_memory(context), true)
+        // qwen-metal P6-2: the operator stop is per completion.
+        stop_requested = false
     }
 
     private func tokenize(text: String, add_bos: Bool) -> [llama_token] {
