 Applications/LLMEval/Views/ContentView.swift  | 23 ++++++++++
 Package.resolved                              | 13 +++++-
 3 files changed, 77 insertions(+), 4 deletions(-)

diff --git a/Applications/LLMEval/ViewModels/LLMEvaluator.swift b/Applications/LLMEval/ViewModels/LLMEvaluator.swift
index 2aacbd2..bcffd2e 100644
--- a/Applications/LLMEval/ViewModels/LLMEvaluator.swift
+++ b/Applications/LLMEval/ViewModels/LLMEvaluator.swift
@@ -47,11 +47,15 @@ class LLMEvaluator {
     private var firstTokenTime: TimeInterval = 0
 
     /// This controls which model loads.
-    var modelConfiguration = LLMRegistry.qwen3_8b_4bit
+    // qwen-metal P0A-1 parity pin: PIN-1 checkpoint, exact revision (DECISIONS.md)
+    var modelConfiguration = ModelConfiguration(
+        id: "mlx-community/Qwen3-1.7B-4bit",
+        revision: "3b1b1768f8f8cf8351c712464f906e86c2b8269e")
 
     /// Parameters controlling the generation output (max tokens and temperature).
     var generateParameters: GenerateParameters {
-        GenerateParameters(maxTokens: maxTokens, temperature: 0.6)
+        // qwen-metal P0A-1 parity pin: greedy sampling (temperature 0)
+        GenerateParameters(maxTokens: maxTokens, temperature: 0.0)
     }
 
     /// A task responsible for handling the generation process.
@@ -387,5 +391,42 @@ class LLMEvaluator {
         generationTimer?.invalidate()
         generationTimer = nil
         running = false
+        looping = false
+    }
+
+    // qwen-metal P0A-1 energy protocol: sustained regenerate loop — repeats
+    // greedy generation with the SAME prompt until stopped (pinned reset
+    // policy: fresh context each generation), accumulating the counters the
+    // battery-delta math needs (total tokens over the burn window).
+    var looping = false
+    var loopStatus = ""
+
+    func startSustainedLoop() {
+        guard !running, !looping else { return }
+        let currentPrompt = prompt
+        guard !currentPrompt.isEmpty else { return }
+        looping = true
+        generationTask = Task {
+            running = true
+            var generations = 0
+            var cumulativeTokens = 0
+            var firstTps: Double = 0.0
+            let wallStart = Date()
+            while looping && !Task.isCancelled {
+                await generate(prompt: currentPrompt)
+                generations += 1
+                cumulativeTokens += totalTokens
+                if generations == 1 { firstTps = tokensPerSecond }
+                let wall = Date().timeIntervalSince(wallStart)
+                loopStatus = String(
+                    format: "LOOP %d gens | %d tokens | %.0fs wall | first %.2f t/s | last %.2f t/s",
+                    generations, cumulativeTokens, wall, firstTps, tokensPerSecond)
+            }
+            running = false
+        }
+    }
+
+    func stopSustainedLoop() {
+        looping = false
     }
 }
diff --git a/Applications/LLMEval/Views/ContentView.swift b/Applications/LLMEval/Views/ContentView.swift
