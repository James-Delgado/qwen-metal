+                    .font(.footnote.monospaced())
+                    .padding(.top, 4)
+            }
         }
         #if os(visionOS)
             .padding(40)
@@ -78,6 +86,21 @@ struct ContentView: View {
                 .labelStyle(.titleAndIcon)
             }
 
+            // qwen-metal P0A-1: sustained regenerate-loop toggle
+            ToolbarItem(placement: .primaryAction) {
+                Button {
+                    if llm.looping {
+                        llm.stopSustainedLoop()
+                    } else {
+                        llm.startSustainedLoop()
+                    }
+                } label: {
+                    Label(
+                        llm.looping ? "Stop Loop" : "Loop",
+                        systemImage: llm.looping ? "stop.circle" : "repeat.circle")
+                }
+                .labelStyle(.titleAndIcon)
+            }
         }
         .task {
             do {
